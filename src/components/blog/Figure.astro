---
interface Props {
  caption?: string
  /** 枠と余白を付けるか。手書き SVG を素のまま置きたい時は false */
  framed?: boolean
}

const { caption, framed = true } = Astro.props
---

<figure class="mt-8 reveal">
  <div class={framed ? 'border border-[#E8E8E8] bg-white p-5 md:p-6 overflow-x-auto' : 'overflow-x-auto'}>
    <slot />
  </div>
  {
    caption && (
      <figcaption class="mt-3 text-[11px] font-light leading-relaxed text-[#888] text-center">
        {caption}
      </figcaption>
    )
  }
</figure>
